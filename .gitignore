/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/data/

# 生图 API 原图归档（母版备份，体积大不进库；线上用的是压缩版）
/assets/portraits-raw/
/assets/scenes-raw/
/assets/lifephotos-raw/

# 视觉资产临时预览目录(doc/15,本机翻看用)
tmp-assets/
/assets/qizai-master-raw/
/assets/qizai-sheet-raw/
/assets/qizai-shots-raw/

# 微信桥的运行时状态(2026-08-07 review):凭据/游标/幂等记录都不进库。
# creds.json 是所有用户的会话凭证——泄露等于替所有人收发消息。
/wechat-bridge/creds.json
/wechat-bridge/creds.json.bak
/wechat-bridge/creds.json.tmp
/wechat-bridge/cursors.json
/wechat-bridge/cursors.json.tmp
/wechat-bridge/seen.json
/wechat-bridge/seen.json.tmp
