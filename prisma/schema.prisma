// 猫啊岛数据模型。设计原则：模拟器产事实，LLM 只负责叙事。
// Event 表是唯一事实来源；DiaryEntry 是叙事层产物，可随时由事实重新生成。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled 连接
  directUrl = env("DATABASE_URL_UNPOOLED") // 非池化直连，migrate/db push 用（Neon 集成自动注入）
}

model User {
  id              String    @id
  name            String
  status          String    @default("anonymous") // anonymous | registered
  email           String?   @unique
  emailVerifiedAt DateTime?
  notifyDaily     Boolean   @default(true) // 每日故事邮件（绑定邮箱后默认开，可关）
  recoveryCode    String?   @unique // 回岛钥匙:密码遗失时的兜底凭证(重置后旋转)
  passwordHash    String? // scrypt(见 lib/password.ts);null = 尚未设置登录凭证的设备身份
  inviteCode      String? // 用的哪个邀请码
  inviteBatch     String? // 来源批次：team | friends | strangers
  lastSeenDay     Int? // 最后一次看 /my-cat 时的世界天数（未回摘要用）
  visitDays       Int       @default(0) // 累计回访天数（纪念册"你来过 N 次"）
  yardAccess      Boolean   @default(false) // 2.1 院子玩法 Capability Flag（14 §九 护栏③）：默认关，内部账号先开；全量开关走 YARD_GAMEPLAY_ENABLED，切换与 D0 尾部同一提交
  createdAt       DateTime
  lastActiveAt    DateTime?
  cats            Cat[]
}

model Cat {
  id          String   @id
  ownerId     String?   @unique // null = NPC 猫；一人一猫由数据库约束兜底（并发防线）
  owner       User?     @relation(fields: [ownerId], references: [id])
  name        String
  isNpc       Boolean  @default(false)
  // 性格：数值轴决定模拟器行为倾向，tags 供叙事层塑造语气
  boldness    Int // 0-100 冒险倾向
  sociability Int // 0-100 社交倾向
  diligence   Int // 0-100 勤劳程度
  personaTags String[]
  role        String? // NPC 分级：function | story | social | background
  goal        String? // 初始目标：earn | friends | explore | chill（影响行为权重）
  ownerNick   String? // 猫对主人的称呼（"铲屎官"/"老大"…），进日记语气
  renamedAt   DateTime? // 改名机会只有一次
  appearance  String // 外形描述，生成立绘用
  portraitUrl String? // 定稿立绘，一次生成反复合成
  arrivalPhotoUrl String? // 相遇照片：第一天你和它在码头（立绘定稿后合成，D1 重构·分享资产）
  firstWords  String? // 主人第一次见面说的话（D1 最重要输入，它会记一辈子）
  // 入场准入（doc/14 §一二）：身份事实显式保存，不由事件倒推；NPC 恒为 0（始终参与模拟）
  arrivalWorldDay Int @default(0) // 领养时的世界日
  firstTickDay    Int @default(0) // 第一次参与 tick 的世界日；world.day < firstTickDay = ARRIVAL 阶段
  bio         String
  createdAt   DateTime

  state      CatState?
  diaries    DiaryEntry[]
  storylines Storyline[]
}

model CatState {
  catId      String @id
  cat        Cat    @relation(fields: [catId], references: [id])
  coins      Int    @default(50) // 鱼币
  energy     Int    @default(100)
  mood       String @default("平静")
  location   String @default("自家小屋")
  updatedDay Int    @default(0)
}

model Item {
  id          String @id
  catId       String
  itemKey     String
  qty         Int    @default(1)
  acquiredDay Int

  @@unique([catId, itemKey])
}

model Relationship {
  id                 String @id
  catAId             String
  catBId             String
  affinity           Int    @default(0) // -100 ~ 100
  kind               String @default("acquaintance") // acquaintance | friend | rival | partner
  lastInteractionDay Int    @default(0)

  @@unique([catAId, catBId])
}

// 未完成的事件线：店还开着、债还欠着——连续性与抗套路的来源
model Storyline {
  id       String  @id
  catId    String
  cat      Cat     @relation(fields: [catId], references: [id])
  kind           String // 事件线 key：shop | debt | lighthouse
  status         String @default("active") // active | resolved | failed
  step           Int    @default(0)
  lastAdvanceDay Int    @default(0)
  data           Json
  startDay       Int
  endDay         Int?
}

// 模拟器每日产出的事实（唯一事实来源）
model Event {
  id           String  @id
  day          Int
  segment      String  @default("morning") // morning | afternoon | evening
  catId        String
  type         String // 模板 key
  outcome      String  @default("success") // success | partial | fail | complication
  data         Json
  deltas       Json
  targetId     String?
  threadKey    String?
  threadStep   Int?
  contentValue Int     @default(1)
  isMain       Boolean @default(false) // 导演选出的当日主事件

  @@index([day, catId])
}

// 叙事层产物：由当日事实生成的猫咪日记
model DiaryEntry {
  id          String   @id
  catId       String
  cat         Cat      @relation(fields: [catId], references: [id])
  day         Int
  content     String
  mood        String
  eventIds    String[] // 溯源：这段话来自哪些事实
  generatedBy String   @default("llm") // llm | fallback
  form        String   @default("diary") // diary | dialogue | note | weekbook
  promptVersion String? // 溯源：当时的提示词版本（doc/14 §五）
  modelId       String? // 溯源：实际使用的模型（fallback 时为空）
  createdAt   DateTime

  @@unique([catId, day])
}

// tick 可观测性 + 叙事熔断计数器（doc/14 §四七）：一天一行
model TickRun {
  targetDay              Int       @id
  status                 String // recovering | completed | dead_letter_advanced
  startedAt              DateTime
  simulationCompletedAt  DateTime?
  narrationCompletedAt   DateTime?
  narrationAttempts      Int       @default(0) // 自愈补叙事的累计次数（熔断判据）
  errorSummary           String?
}

model WorldState {
  id         Int       @id // 恒为 1
  day        Int       @default(0)
  season     String    @default("夏")
  weather    String    @default("晴")
  lastTickAt     DateTime? // 每日幂等闸门：距上次推进不足最小间隔则拒绝
  adoptionPaused Boolean   @default(false) // 后台一键暂停新领养
  wechatPaused   Boolean   @default(false) // 微信通道熔断：admin 手动或监控自动停发（doc/13 T8）
}

// ============ 现实连接通道（doc/11 生命连接层）============
// 绑定资产永远落 userId，通道(kind)可替换——换号/迁通道不丢关系。
model Channel {
  id              String    @id
  userId          String
  kind            String // wechat_openclaw | email
  externalId      String // openclaw 侧的 wxid / 联系人 id
  windowOpenUntil DateTime? // 24h 硬窗口：用户任何一次入站消息刷新（doc/11 §六）
  boundAt         DateTime
  mutedAt         DateTime? // 用户说"别再捎信"
  giftSentAt      DateTime? // 绑定见面礼（合影+一句猫声）已寄，防重复
  // 一来一回节流（doc/11 修订·门铃规则）：同一北京日,猫对入站最多一条实质回复+一条收束
  replyDay        Int       @default(0) // yyyymmdd
  repliesInDay    Int       @default(0)

  @@unique([kind, externalId])
  // 一人一微信也要库级兜底（2026-08-07 review P2）：原先只约束了"一个微信只能绑一个人"，
  // 没约束"一个人只能有一个微信通道"——并发扫码能给同一用户建出两条,消息就发两遍。
  @@unique([userId, kind])
  @@index([userId])
}

// 站内短链：微信消息里的深链太长（HMAC 令牌），压成 /s/{code}；只允许站内相对路径，防开放跳转
model ShortLink {
  code      String    @id // 7 位 base62
  target    String // 站内相对路径（以 / 开头）
  hits      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime

  @@index([createdAt])
}

// 微信留言全量记录（门铃审计面）：不论是否回复/是否落为留言，每条入站都记——
// 管理后台可查，收到即同步飞书。matched = activation | status | nudge | closed | silent | unsubscribed | unknown | ignored
model WechatMessageLog {
  id        String   @id
  openId    String
  userId    String?
  catName   String?
  text      String
  matched   String
  createdAt DateTime

  @@index([createdAt])
}

// 出站信箱：tick 时排队，dispatch cron 错峰发送；窗口外的落 window_closed = "未寄出的信"
model OutboundMessage {
  id        String    @id
  userId    String
  catId     String
  day       Int // 世界日
  kind      String // handshake | d2_promise | event | absence
  content   String
  link      String?
  status    String    @default("queued") // queued | sending | sent | window_closed | failed
  sendAfter DateTime // 8:00-8:40 随机打散（防群发特征）
  sentAt    DateTime?
  createdAt DateTime
  // 原子领取（2026-08-07 review P1）：先条件更新抢成 sending 再发，
  // 并发 cron / 重放 / 发出去但响应超时都不会让猫把同一句话说两遍。
  // claimedAt 兼作卡单回收依据：sending 超过 10 分钟视为进程挂了，放回 queued。
  claimedAt DateTime?
  claimId   String?

  @@index([status, sendAfter])
  @@index([userId, day])
  @@index([claimId])
}

// 双层记忆的主观层：观察/关系/情节/语义（客观事实由上面的结构化表维护）
model MemoryEntry {
  id         String @id
  catId      String
  day        Int
  kind       String // observation | relation | emotion | thread | semantic
  content    String
  refId      String?
  importance Int    @default(3)
  visibility String @default("public") // public | private（private 不进公开日记）

  @@index([catId, day])
}

// 岛屿动态：导演选出的全岛新闻（LLM 润色，失败则用事实转写）
model IslandNews {
  id        String   @id
  day       Int
  content   String
  catId     String?
  createdAt DateTime

  @@index([day])
}

// 用户轻量干预：留言 + 明日建议（消费一次即失效）
model OwnerNudge {
  id          String   @id
  catId       String
  message     String?
  suggestion  String? // earn | explore | social | rest
  isPublic    Boolean  @default(false) // 留言是否允许出现在公开日记
  consumedDay Int? // 被哪一天的模拟消费
  createdAt   DateTime

  @@index([catId, consumedDay])
}

// 定稿立绘：一次生成反复复用（角色一致性的根基），bytes 直存 DB（MVP 规模足够）
model Portrait {
  catId     String   @id
  data      Bytes
  mime      String   @default("image/jpeg")
  createdAt DateTime
}

// L1 姿势集（doc/15 图片导演系统）：立绘之外的复用姿势，领养时生成一次，
// 日常生活图全靠这些贴纸拼贴——绝不按天生成
model CatPose {
  catId     String
  pose      String // sit | sleep | walk | play | lookout
  data      Bytes
  mime      String   @default("image/jpeg")
  createdAt DateTime

  @@id([catId, pose])
}

// 猫的留声（海螺）：TTS 生成的猫声。iLink 不给 Bot 下发语音消息（2026-08-03 实测），
// 声音存站内播放，微信只寄带短链的一句话
model CatVoiceNote {
  catId      String   @id
  data       Bytes // wav
  mime       String   @default("audio/wav")
  text       String // 说的内容
  durationMs Int
  createdAt  DateTime
}

// 相遇照片：第一天在码头的拍立得（立绘定稿后合成一次，永久保存）
model ArrivalPhoto {
  catId     String   @id
  data      Bytes
  mime      String   @default("image/jpeg")
  createdAt DateTime
}

// 每日结果聚合：/my-cat 今日页直接读这个对象，不从 events 现拼（定义·十）
model CatDailySummary {
  id                   String   @id
  catId                String
  day                  Int
  headline             String // 今日标题
  narrative            String // 80-150 字叙事（即当日日记）
  interventionResponse String? // 昨日建议回执：你的建议产生了什么影响
  tomorrowHook         String? // 明日悬念：下一次召回理由
  stateChanges         Json // 关键状态变化 [{label, delta}]
  threadProgress       Json // 事件线进度 [{key, label, step, total?}]
  choices              Json? // 动态剧情选择 [{value,label}]（D5-6 替代固定四选一）
  createdAt            DateTime

  @@unique([catId, day])
}

// 邮箱验证码（绑定与登录共用）：只存 HMAC 哈希，单码限试 5 次，原子消费
// 设备会话(doc/20 §八):cookie 里放会话令牌而不是账户 id,这样才能远程踢出某台设备。
// 匿名设备身份仍走长效 uid cookie;一旦设了登录凭证,就必须持有效会话才算登录。
model Session {
  id         String    @id
  userId     String
  tokenHash  String    @unique // sha256(token);明文只在 cookie 里
  label      String? // 设备标签(UA 粗略推断,给用户认得出是哪台)
  createdAt  DateTime
  lastSeenAt DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

// 邮箱验证挑战(doc/20 §七 EmailVerificationChallenge 的落地形态,沿用历史表名)。
// purpose 区分用途:确认自己的登录邮箱 / 改成新邮箱 / 已验证邮箱的密码重置——
// 一码只能用于签发时的那个用途,不能跨用途兑换。
model LoginCode {
  id           String    @id
  email        String
  purpose      String    @default("VERIFY_EMAIL") // VERIFY_EMAIL | CHANGE_EMAIL | RESET_PASSWORD
  userId       String? // 发起挑战的账户;锚定后验证码只能用在这个账户上
  codeHash     String
  attemptCount Int       @default(0)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime

  @@index([email, createdAt])
}

// 认证类失败审计与滑动窗口限频（验证码校验失败、找回码失败）
model AuthAttempt {
  id        String   @id
  kind      String // verify_email_fail | recover_fail
  key       String // email 或 viewer uid/ip
  createdAt DateTime

  @@index([kind, key, createdAt])
}

// 审核拦截日志：后台抽检"被拦了什么、为什么"
model ModerationLog {
  id        String   @id
  verdict   String // block | error_pass
  reason    String?
  input     String
  createdAt DateTime
}

// 封闭内测邀请码（船票）：限次数、分批次（成本控制 + 按批次分析）
// 领养成功即发 5 张可转赠船票（issuedTo = 发出者），邀请链：新用户.inviteCode → 票.issuedTo
model InviteCode {
  code      String   @id
  batch     String // team | friends | strangers | islander（岛民转赠）
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  disabled  Boolean  @default(false)
  issuedTo  String? // 这张票属于哪位岛民（null = 官方发放）
  createdAt DateTime

  @@index([issuedTo])
}

// 内容人工评分：回答"什么内容真正带来次日留存"（v0.7.0·7）
model ContentRating {
  id          String   @id
  summaryId   String   @unique
  continuity  Int? // 连续性 1-5
  persona     Int? // 人格感 1-5
  fun         Int? // 趣味性 1-5
  emotion     Int? // 情绪强度 1-5
  suspense    Int? // 悬念质量 1-5
  templated   Boolean? // 模板感
  factError   Boolean? // 事实错误
  shareworthy Boolean? // 值得分享
  note        String?
  createdAt   DateTime
}

// 入岛三件事：新岛民的一次性到岸便条（不是每日任务，做完收进生活册永不再现）
model ArrivalNote {
  catId          String    @id
  metNpcIds      String[] // 认识过的邻居（看过公开主页的 NPC）
  promisedAt     DateTime? // 记住了"明早八点"的约定
  archivedAt     DateTime? // 三件事做完并展示过一次后收册
  celebratedKeys String[]  @default([]) // 已展示过"刚办妥"庆祝的任务 key（每件事只庆祝一次）
}

// 读者来信：岛民给《猫啊岛日报》递的线索（用户在世界里留下痕迹）
model NewsTip {
  id          String   @id
  catId       String
  content     String
  publishedAt DateTime?
  publishDay  Int? // 登在第几期日报
  createdAt   DateTime

  @@index([publishedAt])
}

// 第一周纪念册：首周最高价值内容（v0.8 D7）
model WeekBook {
  id        String   @id
  catId     String
  weekIndex Int      @default(1)
  content   Json // {topMoments[], bestFriend, messageCount, visitDays, adoptionExample, catLine, keepsakes[], nextWeekWish}
  createdAt DateTime

  @@unique([catId, weekIndex])
}

// ============================================================
// 2.1 院子玩法·事实骨架（doc2.0/16-22，开工第一刀 2026-08-07）
// 三层分离（16）：CatVisit=世界事实（永不残缺）；visibility 列=暴露度
// （Disclosure 的 MVP 折叠实现，语义独立）；Observation=观察事实。
// 历史事实锁两样：输入快照（placementSnapshot）+ 规则版本（rulesVersion）——
// 晚算不晚取，昨天的世界永不被今天的数值重算（14 §九 护栏②）。

model Home {
  id        String      @id
  userId    String      @unique // 幂等闩：一人一 Home 由数据库兜底（护栏①）
  fish      Int         @default(0) // 小鱼干账户（19：资源可计数）
  createdAt DateTime
  yard      Yard?
  grants    HomeGrant[]
  items     OwnedItem[]
}

model Yard {
  id         String      @id
  homeId     String      @unique // 一 Home 一 Yard（护栏①）
  createdAt  DateTime
  home       Home        @relation(fields: [homeId], references: [id])
  slots      YardSlot[]
  placements Placement[]
}

model YardSlot {
  id      String @id
  yardId  String
  slotKey String // 配置键（lib/yard/config.ts 单一数据源）：eaves | tree | clearing
  yard    Yard   @relation(fields: [yardId], references: [id])

  @@unique([yardId, slotKey]) // 同院同位不重复建（护栏①）
}

model Placement {
  id        String    @id
  yardId    String
  slotKey   String
  itemKey   String
  placedAt  DateTime
  removedAt DateTime? // null=仍在摆；历史保留，窗口快照由 [placedAt, removedAt) 重建
  yard      Yard      @relation(fields: [yardId], references: [id])

  @@index([yardId, placedAt])
}

model OwnedItem {
  id         String   @id
  homeId     String
  itemKey    String
  source     String // initial | purchase | exchange
  acquiredAt DateTime
  home       Home     @relation(fields: [homeId], references: [id])

  @@index([homeId])
}

// 发放批次哨兵（护栏①）：初始资产恰好一份——不靠先查再插，靠唯一冲突收敛
model HomeGrant {
  homeId    String
  batchKey  String // "initial" …
  grantedAt DateTime
  home      Home     @relation(fields: [homeId], references: [id])

  @@id([homeId, batchKey])
}

// 窗口结算事实（16）：确定性种子 + 窗口起点快照 + 规则版本
model WindowSettlement {
  id                String     @id
  yardId            String
  dayKey            String // 北京日 yyyymmdd（v0：窗口时间轴独立于 WorldState.day，映射可替换）
  windowIndex       Int // 0..12（lib/yard/config.ts）
  rulesVersion      String // 当时按哪一版规则算的（护栏②）
  placementSnapshot Json // 窗口起点布置快照 [{slotKey,itemKey}]
  weather           String // 结算时的天气快照（v0 由 dayKey 确定性派生，实现可替换）
  settledAt         DateTime
  visits            CatVisit[]

  @@unique([yardId, dayKey, windowIndex]) // 一窗一结算：lazy settlement 的幂等收敛点
}

model CatVisit {
  id           String           @id
  settlementId String
  yardId       String
  catId        String
  dayKey       String
  windowIndex  Int
  slotKey      String?
  itemKey      String?
  arriveAt     DateTime
  leaveAt      DateTime
  behaviors    Json // string[]（含无用行为——L3 保留地）
  leftBehind   Json // { fish: number }（纪念物另表，19 P0：不可逆记忆不入经济）
  traces       Json // string[]
  visibility   String // FULL_RECORD | TRACE_ONLY（暴露度折叠列；LIVE 属 Observation）
  rulesVersion String // 护栏②
  settlement   WindowSettlement @relation(fields: [settlementId], references: [id])
  observations Observation[]

  @@index([yardId, dayKey])
  @@index([catId, dayKey])
}

// 观察事实（16 三层之三）：开门只产生观察，永不改写世界；观察无收益差
model Observation {
  id         String   @id
  viewerId   String
  visitId    String
  type       String // LIVE | RECORD | TRACE | PHOTO
  observedAt DateTime
  visit      CatVisit @relation(fields: [visitId], references: [id])

  @@unique([viewerId, visitId, type])
  @@index([viewerId])
}

// 机会累积（22 §四）：Cat×Yard 的 eligible miss streak——
// 压随机长尾的系统公平机制，与"用户目标"概念无关；本刀只建表，累积逻辑随来访引擎落
model CatOpportunityState {
  catId                     String
  yardId                    String
  consecutiveEligibleMisses Int      @default(0)
  updatedAt                 DateTime

  @@id([catId, yardId])
}
